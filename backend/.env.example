# Application
APP_NAME=FloodMonitor
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/floodmonitor

# JWT Security
# REQUIRED. At least 32 random characters; the app refuses to start with a placeholder.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin onboarding: single-use invites (no shared token).
# Create one with: venv/bin/python scripts/create_admin_invite.py --role super_admin
ADMIN_INVITE_EXPIRE_HOURS=72

# Rate limiting (per client IP, slowapi syntax e.g. 5/minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_SUBMIT=10/minute
RATE_LIMIT_PUBLIC=60/minute

# Sensors / live data
# A sensor is shown offline when nothing was received for this many minutes
SENSOR_OFFLINE_AFTER_MINUTES=5
# Readings older than this are not used for the live flood prediction
LIVE_READING_WINDOW_MINUTES=60

# Max size of SOS / feedback photo uploads (larger files get HTTP 413)
MAX_UPLOAD_MB=5

# IoT device keys are per sensor and stored hashed in the database (not in .env).
# Issue one with: venv/bin/python scripts/provision_device_key.py <sensor_id>

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS (Twilio)
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_FROM=+1234567890

# Push Notifications (Firebase)
FCM_SERVER_KEY=your_fcm_server_key

# AI / ML
OPENAI_API_KEY=your_openai_api_key
WATSON_API_KEY=your_watson_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
FLOOD_IMPACT_DEFAULT_RADIUS_KM=5.0
AI_CACHE_TTL_SECONDS=120

# Weather API
WEATHER_API_KEY=your_openweathermap_api_key

# Google Maps
GOOGLE_MAPS_KEY=your_google_maps_key

# Google OAuth 2.0 (Citizen Sign-In)
GOOGLE_CLIENT_ID=

